<Window x:Class="ParkingManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ParkingManagement.UI.Views"
        xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
        Title="GOPark - Parking Management System" Height="800" Width="1280" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParkingSpacesViewModel}"><views:ParkingSpacesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiclesViewModel}"><views:VehiclesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehicleEntryViewModel}"><views:VehicleEntryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehicleExitViewModel}"><views:VehicleExitView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReservationsViewModel}"><views:ReservationsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}"><views:AuditLogView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Auto + Collapsed sidebar: login fills the full window and stays centered -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Width="260" Background="{StaticResource SidebarBrush}" 
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,40,0,30">
                    <TextBlock Text="GOPark" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock Text="Parkraum-Management" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0">
                        <TextBlock Text="HAUPTMENÜ" Foreground="#64748B" FontSize="12" FontWeight="Bold" Margin="16,0,0,12"/>
                        
                        <Button Content="Übersicht" Command="{Binding GoToDashboardCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Einfahrt" Command="{Binding GoToEntryCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Ausfahrt" Command="{Binding GoToExitCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Parkplätze" Command="{Binding GoToSpacesCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Fahrzeuge" Command="{Binding GoToVehiclesCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Reservierungen" Command="{Binding GoToReservationsCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="Parkvorgänge" Command="{Binding GoToReportsCommand}" Style="{StaticResource SidebarNavButton}"/>
                        
                        <TextBlock Text="VERWALTUNG" Foreground="#64748B" FontSize="12" FontWeight="Bold" Margin="16,24,0,12"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        
                        <Button Content="Benutzer" Command="{Binding GoToUsersCommand}" Style="{StaticResource SidebarNavButton}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Einstellungen" Command="{Binding GoToSettingsCommand}" Style="{StaticResource SidebarNavButton}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Audit-Log" Command="{Binding GoToAuditLogCommand}" Style="{StaticResource SidebarNavButton}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- User Info & Logout -->
                <StackPanel Grid.Row="2" Margin="24,10,24,24">
                    <TextBlock Text="{Binding UserNameDisplay}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding UserRoleDisplay}" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,12"/>
                    <Button Content="Abmelden" Command="{Binding LogoutCommand}" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="16,12" Cursor="Hand" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Top Bar -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Bar -->
            <Border Grid.Row="0" Height="60" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="24,0">
                    <!-- Left Side: Title -->
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    
                    <!-- Right Side: Status and User Info -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTimeString}" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center">
                            <Run Text="{Binding UserNameDisplay, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding UserRoleDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding IsServiceOnline, Converter={StaticResource BooleanToColorConverter}}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ServiceStatus, StringFormat='Service: {0}'}" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0"/>
            
            <!-- Toast Notification -->
            <Border Grid.Row="1" Background="#334155" CornerRadius="8" Padding="20,12" 
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>

