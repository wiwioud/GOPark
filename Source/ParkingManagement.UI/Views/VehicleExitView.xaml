<UserControl x:Class="ParkingManagement.UI.Views.VehicleExitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:VehicleExitViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Ausfahrt erfassen" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="Wählen Sie einen aktiven Parkvorgang und bestätigen Sie die Ausfahrt."
                           FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Session list -->
            <Grid Grid.Column="0" Margin="0,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SaaSInput}"
                         Tag="Kennzeichen oder Parkplatz suchen..."
                         Margin="0,0,0,16"/>

                <!-- List area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Empty state message -->
                        <TextBlock Text="Keine aktiven Parkvorgänge vorhanden."
                                   Foreground="#94A3B8" FontSize="14" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Session cards -->
                        <ItemsControl ItemsSource="{Binding ActiveSessionsList}" x:Name="SessionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Vehicle.LicensePlate}"
                                                           FontSize="17" FontWeight="Bold"
                                                           Foreground="#0F172A" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ParkingSpace.SpaceNumber}"
                                                           FontSize="14" Foreground="#475569" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding EntryTime, StringFormat='Einfahrt: {0:dd.MM.yyyy HH:mm}'}"
                                                           FontSize="13" Foreground="#64748B"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Auswählen"
                                                    Style="{StaticResource OutlineButton}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT: Details card (only visible when session selected) -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="24" VerticalAlignment="Top"
                    Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Ausfahrt bestätigen" FontSize="17" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fahrzeug" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Vehicle.LicensePlate}"
                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Parkplatz" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.ParkingSpace.SpaceNumber}"
                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Einfahrt" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedSession.EntryTime, StringFormat='dd.MM.yyyy HH:mm'}"
                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,8,0,16"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gesamtbetrag" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CalculatedFee, StringFormat='{}{0:N2} €'}"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>

                    <TextBlock Text="Zahlungsart" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton Content="Bar" IsChecked="{Binding IsPaymentBar, Mode=TwoWay}"
                                     FontSize="14" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Content="EC-Karte" IsChecked="{Binding IsPaymentCard, Mode=TwoWay}"
                                     FontSize="14" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Ausfahrt bestätigen"
                            Command="{Binding RegisterExitCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="48" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
