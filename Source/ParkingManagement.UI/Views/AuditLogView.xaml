<UserControl x:Class="ParkingManagement.UI.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:AuditLogViewModel}"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audit-Log" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Nachvollziehbare System- und Benutzeraktivitaeten" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="CSV exportieren" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters row -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SaaSInput}" Tag="Benutzer, Aktion, Bereich suchen..." Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Alle" Style="{StaticResource SaaSFilterButton}" IsChecked="True"
                                 Command="{Binding FilterCommand}" CommandParameter="Alle"/>
                    <RadioButton Content="Login" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Login"/>
                    <RadioButton Content="Einfahrt" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Entry"/>
                    <RadioButton Content="Ausfahrt" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Exit"/>
                    <RadioButton Content="Erstellt" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Create"/>
                    <RadioButton Content="Geaendert" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Update"/>
                </StackPanel>
            </Grid>

            <!-- Table -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Keine Audit-Eintraege gefunden."
                               Foreground="#94A3B8" FontSize="14" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoLogs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource SaaSDataGrid}" RowStyle="{StaticResource SaaSDataGridRow}"
                              ColumnHeaderStyle="{StaticResource SaaSDataGridColumnHeader}"
                              CellStyle="{StaticResource SaaSDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Benutzer" Binding="{Binding User.Username}" Width="110"/>
                            <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="100"/>
                            <DataGridTextColumn Header="Bereich" Binding="{Binding EntityType}" Width="110"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
