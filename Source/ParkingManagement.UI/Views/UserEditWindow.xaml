<Window x:Class="ParkingManagement.UI.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzer" Width="440" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                   Foreground="#0F172A" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Benutzername *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SaaSInput}" Margin="0,0,0,14"/>

            <TextBlock Text="Passwort" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PwBox" Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,4" PasswordChanged="PwBox_PasswordChanged"/>
            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,0,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Mindestens 6 Zeichen."/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNewUser}" Value="False">
                                <Setter Property="Text" Value="Leer lassen, um Passwort nicht zu aendern."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Rolle" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                      Style="{StaticResource SaaSComboBox}" Margin="0,0,0,16"/>

            <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="Speichern" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
