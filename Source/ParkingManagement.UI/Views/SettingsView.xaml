<UserControl x:Class="ParkingManagement.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="Systemkonfiguration und Parkgebuehren verwalten." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Parking rates section -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Parkgebuehren" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,20"/>

                        <!-- Hourly rate -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Stundensatz" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Preis pro angefangener Stunde." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.HourlyRate, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                         Style="{StaticResource SaaSInput}" Width="130"/>
                                <TextBlock Text=" EUR" VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- Minimum charge -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Mindestgebuehr" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Mindestbetrag auch bei kurzer Parkdauer." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.MinimumCharge, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                         Style="{StaticResource SaaSInput}" Width="130"/>
                                <TextBlock Text=" EUR" VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- Grace period -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Kulanzzeit (Minuten)" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Zeit ohne Gebuehr beim Ein- und Ausfahren." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.GracePeriodMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SaaSInput}" Width="130"/>
                                <TextBlock Text=" Min." VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- Daily maximum -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Tagesmaximum" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Maximalbetrag pro 24 Stunden." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.MaximumDailyRate, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                         Style="{StaticResource SaaSInput}" Width="130"/>
                                <TextBlock Text=" EUR" VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Validation message -->
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ValidationError}" Foreground="#DC2626" FontSize="13"/>
                        </Border>

                        <Button Content="Aenderungen speichern" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- System status section -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Systemstatus" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Datenbank" Foreground="#475569" FontSize="14"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Verbunden" Foreground="#10B981" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitoring" Foreground="#475569" FontSize="14"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding ServiceOnlineColor}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding ServiceStatusText}" FontWeight="SemiBold" FontSize="14">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding ServiceOnlineColor}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Anwendung" Foreground="#475569" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="GOPark" Foreground="#0F172A" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Version" Foreground="#475569" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="1.0" Foreground="#0F172A" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
