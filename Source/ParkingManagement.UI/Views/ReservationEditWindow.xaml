<Window x:Class="ParkingManagement.UI.Views.ReservationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservierung erstellen" Width="480" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reservierung erstellen" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="Parkplatz fuer ein Fahrzeug reservieren" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Fahrzeug *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Vehicles}"
                      SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                      DisplayMemberPath="LicensePlate"
                      Style="{StaticResource SaaSComboBox}" Margin="0,0,0,14"/>

            <TextBlock Text="Parkplatz *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding ParkingSpaces}"
                      SelectedItem="{Binding SelectedSpace, Mode=TwoWay}"
                      DisplayMemberPath="SpaceNumber"
                      Style="{StaticResource SaaSComboBox}" Margin="0,0,0,14"/>

            <TextBlock Text="Datum *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding ReservationDate, Mode=TwoWay}"
                        Margin="0,0,0,14" FontSize="14" Height="40"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Von *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SaaSInput}" Tag="HH:mm"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Bis *" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SaaSInput}" Tag="HH:mm"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Notizen" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SaaSInput}" Tag="Optional..." Margin="0,0,0,10"/>

            <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="Reservierung erstellen" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" Width="180"/>
        </StackPanel>
    </Grid>
</Window>
