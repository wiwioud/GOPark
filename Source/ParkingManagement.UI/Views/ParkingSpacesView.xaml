<UserControl x:Class="ParkingManagement.UI.Views.ParkingSpacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:ParkingSpacesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Parkplätze" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="Verwalten Sie alle Stellplätze und deren aktuellen Status." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SaaSInput}" Tag="Suchen..."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton Content="Alle" Style="{StaticResource SaaSFilterButton}" IsChecked="True"
                                 Command="{Binding FilterCommand}" CommandParameter="Alle"/>
                    <RadioButton Content="Frei" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Frei"/>
                    <RadioButton Content="Belegt" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Belegt"/>
                    <RadioButton Content="Reserviert" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Reserviert"/>
                    <RadioButton Content="Außer Betrieb" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterCommand}" CommandParameter="Außer Betrieb"/>
                </StackPanel>
                <Button Grid.Column="2" Content="+ Parkplatz hinzufügen"
                        Command="{Binding AddSpaceCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="16,8"/>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Keine Parkplätze gefunden." Foreground="#94A3B8" FontSize="15" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoSpaces, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <DataGrid ItemsSource="{Binding Spaces}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource SaaSDataGrid}"
                              ColumnHeaderStyle="{StaticResource SaaSDataGridColumnHeader}"
                              CellStyle="{StaticResource SaaSDataGridCell}"
                              SelectedItem="{Binding SelectedSpace}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="MinHeight" Value="44"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                        <Setter Property="Background" Value="#FFF7ED"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Out of Order">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nummer" Binding="{Binding SpaceNumber}" Width="120"/>
                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="100"/>
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                            <Setter Property="Background" Value="#F97316"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Out of Order">
                                                            <Setter Property="Background" Value="#94A3B8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGermanConverter}}"
                                                       Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aktion" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Bearbeiten"
                                                Command="{Binding DataContext.EditSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
