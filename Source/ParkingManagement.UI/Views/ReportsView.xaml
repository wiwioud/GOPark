<UserControl x:Class="ParkingManagement.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParkingManagement.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Parkvorgänge &amp; Berichte" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Analysieren Sie Einnahmen und die Parkhistorie." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Als CSV exportieren" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SaaSInput}" Tag="Kennzeichen oder Parkplatz suchen..." Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="Alle" Style="{StaticResource SaaSFilterButton}" IsChecked="True"
                                     Command="{Binding FilterStatusCommand}" CommandParameter="Alle"/>
                        <RadioButton Content="Aktiv" Style="{StaticResource SaaSFilterButton}"
                                     Command="{Binding FilterStatusCommand}" CommandParameter="Aktiv"/>
                        <RadioButton Content="Abgeschlossen" Style="{StaticResource SaaSFilterButton}"
                                     Command="{Binding FilterStatusCommand}" CommandParameter="Abgeschlossen"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Zeitraum:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton Content="Heute" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterDateCommand}" CommandParameter="Heute"/>
                    <RadioButton Content="Diese Woche" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterDateCommand}" CommandParameter="Diese Woche"/>
                    <RadioButton Content="Dieser Monat" Style="{StaticResource SaaSFilterButton}"
                                 Command="{Binding FilterDateCommand}" CommandParameter="Dieser Monat"/>
                    <RadioButton Content="Alle Zeiten" Style="{StaticResource SaaSFilterButton}" IsChecked="True"
                                 Command="{Binding FilterDateCommand}" CommandParameter="Alle Zeiten"/>
                </StackPanel>
            </Grid>

            <!-- Table -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Keine Parkvorgänge für den gewählten Filter gefunden."
                               Foreground="#94A3B8" FontSize="15" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <DataGrid ItemsSource="{Binding CompletedSessions}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource SaaSDataGrid}" RowStyle="{StaticResource SaaSDataGridRow}"
                              ColumnHeaderStyle="{StaticResource SaaSDataGridColumnHeader}"
                              CellStyle="{StaticResource SaaSDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kennzeichen" Binding="{Binding Vehicle.LicensePlate}" Width="130"/>
                            <DataGridTextColumn Header="Parkplatz" Binding="{Binding ParkingSpace.SpaceNumber}" Width="100"/>
                            <DataGridTextColumn Header="Einfahrt" Binding="{Binding EntryTime, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="Ausfahrt" Binding="{Binding ExitTime, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="Gebühr" Binding="{Binding ParkingFee, StringFormat='{}{0:N2} €'}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGermanConverter}}"
                                                       Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
